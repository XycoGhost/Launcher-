name: Build APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q OneUILauncher.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.9
      - run: gradle -p OneUILauncher :app:assembleRelease --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: OneUI-Launcher-apk
          path: OneUILauncher/app/build/outputs/apk/release/*.apk
